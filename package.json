{
  "name": "weber-nexus",
  "description": "Webercom predictive and analysis for Banner Engineering sensors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://www.webercom.com.br/",
  "author": {
    "name": "Carlito Murta",
    "email": "carlitomurtaramalho@gmail.com",
    "url": "https://www.carlitomurta.com/"
  },
  "license": "UNLICENSED",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "dev": "node scripts/ensure-node-native-modules.mjs && turbo run dev --filter=!@weber-nexus/runtime",
    "build": "yarn build:dev",
    "build:prod": "node scripts/build-system-channel.mjs production",
    "build:dev": "node scripts/build-system-channel.mjs development",
    "test:playwright": "node tests/playwright/scripts/build-desktop.mjs && playwright test -c tests/playwright/playwright.config.ts",
    "test:playwright:ui": "node tests/playwright/scripts/build-desktop.mjs && playwright test -c tests/playwright/playwright.config.ts --ui",
    "runtime:stop": "yarn workspace @weber-nexus/runtime stop",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "release:validate": "node scripts/release/validate-release-inputs.mjs",
    "release:collect-artifacts": "node scripts/release/collect-release-artifacts.mjs",
    "release:write-sha256": "node scripts/release/write-sha256.mjs",
    "release:manifest": "node scripts/release/generate-nexus-manifest.mjs"
  },
  "engines": {
    "npm": ">=9.0.0 <=10",
    "node": ">=18.0.0 <=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "resources/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.2",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  }
}
