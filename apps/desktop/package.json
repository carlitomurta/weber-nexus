{
  "name": "@weber-nexus/desktop",
  "description": "Electron app for nexus frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://www.webercom.com.br/",
  "author": {
    "name": "Carlito Murta",
    "email": "carlitomurtaramalho@gmail.com",
    "url": "https://www.carlitomurta.com/"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-channel.mjs",
    "build:prod": "node scripts/build-channel.mjs production",
    "build:dev": "node scripts/build-channel.mjs development",
    "build:bundle": "yarn build:runtime && yarn routes:generate && tsc && vite build",
    "build:runtime": "yarn workspace @weber-nexus/logger build && yarn workspace @weber-nexus/database dev && yarn workspace @weber-nexus/repository build && yarn workspace @weber-nexus/modbus build && yarn workspace @weber-nexus/polling-engine build && yarn workspace @weber-nexus/runtime build",
    "build:windows": "node scripts/build-windows.mjs",
    "build:linux": "node scripts/build-linux.mjs",
    "lint": "eslint . --config eslint.config.mjs --max-warnings 0",
    "preview": "vite preview",
    "prettier": "prettier . -w",
    "routes:generate": "node scripts/generate-routes.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-core": "^1.171.16",
